 /* wallust template - colors-rofi */

* {
active-background: #D6D6D6;
active-foreground: #FAFAFA;
normal-background: #292929;
normal-foreground: #FAFAFA;
urgent-background: #E2E2E2;
urgent-foreground: #FAFAFA;

alternate-active-background: #919191;
alternate-active-foreground: #FAFAFA;
alternate-normal-background: #292929;
