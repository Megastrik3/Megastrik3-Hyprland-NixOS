background-color: #292929;
background: rgba(0,0,0,0.7);
foreground: #FAFAFA;
border-color: #D6D6D6;

color0: #4E4E4E;
color1: #414141;
color2: #626262;
color3: #6D6D6D;
color4: #A1A1A1;
color5: #A9A9A9;
